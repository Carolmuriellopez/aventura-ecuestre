msgstr "Tägliche Reinigung und durchgehende Wasserversorgung"

#: main/templates/main/activities.html:308
msgid "Dos pistas de entrenamiento — circular y de grandes dimensiones"
msgstr "Zwei Trainingsplätze — ein Roundpen und ein großer Reitplatz"

#: main/templates/main/activities.html:312
msgid "Hospedamos a tu caballo durante tus vacaciones"
msgstr "Wir betreuen dein Pferd während deines Urlaubs"

#: main/templates/main/activities.html:322
msgid "Pregúntanos sin compromiso — adaptamos el servicio a tus necesidades."
msgstr "Frag uns unverbindlich — wir passen den Service an deine Bedürfnisse an."

#: main/templates/main/activities.html:344
msgid "CONSULTAR DISPONIBILIDAD"
msgstr "VERFÜGBARKEIT ANFRAGEN"

